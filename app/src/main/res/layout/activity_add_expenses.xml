<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".add_expenses">



    <!-- Top bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:background="?android:selectableItemBackgroundBorderless"
            android:src="@drawable/img_10"
            />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Add Expense"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#000000" />
    </RelativeLayout>

    <!-- Content -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/btnSave">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Amount -->
            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#F4EEEE"
                android:hint="$ 0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:inputType="numberDecimal" />

            <!-- Category dropdown look -->
            <RelativeLayout
                android:id="@+id/rowCategory"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"

                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="#F4EEEE"
                    android:spinnerMode="dropdown"
                    />

                <!-- Chevron on right (visual only) -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/img_11" />
            </RelativeLayout>

            <!-- Notes -->
            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="#F4EEEE"
                android:hint="Notes"
                android:drawablePadding="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="textCapSentences|textMultiLine"
                android:drawableLeft="@drawable/img_12" />

            <!-- Attach receipt pill button -->
            <Button
                android:id="@+id/btnAttach"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#C6EBFB"
                android:text="Attach Receipt"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="#2263FF"
                android:drawableLeft="@android:drawable/ic_menu_camera"
                android:drawablePadding="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="300dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Save button fixed to bottom -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="#3CBBF0"
        android:text="Save Expense"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"/>



</RelativeLayout>